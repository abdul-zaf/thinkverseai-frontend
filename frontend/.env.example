# ── LiveKit (required for voice agent) ───────────────────────────────────────
LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY="your_livekit_api_key"
LIVEKIT_API_SECRET="your_livekit_api_secret"

# ── OpenAI (required for voice agent LLM) ────────────────────────────────────
OPENAI_API_KEY="your_openai_api_key"

# ── Deepgram (required for speech-to-text) ───────────────────────────────────
DEEPGRAM_API_KEY="your_deepgram_api_key"

# ── Cartesia (required for text-to-speech) ───────────────────────────────────
CARTESIA_API_KEY="your_cartesia_api_key"

# ── D-ID (required for AI avatar video) ──────────────────────────────────────
DID_API_KEY="your_did_api_key"
DID_PRESENTER_ID="your_did_presenter_id"

# ── Google Gemini (required for service card image generation) ────────────────
GEMINI_API_KEY="your_gemini_api_key"
